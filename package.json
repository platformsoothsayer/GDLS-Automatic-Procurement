{
  "name": "industrial-data-fabric-preview",
  "version": "0.1.0",
  "private": true,
  "description": "Client-facing pre-sales preview of an industrial data fabric. All data is illustrative.",
  "scripts": {
    "generate": "tsx scripts/generate.ts",
    "prebuild": "npm run check:nomenclature && npm run check:bundles && npm run generate",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "check:nomenclature": "node scripts/check-nomenclature.mjs",
    "verify": "npm run check:nomenclature && npm run check:bundles && npm run typecheck && npm run build",
    "review": "tsx scripts/nomenclature-review.ts",
    "check:bundles": "node scripts/check-client-bundles.mjs"
  },
  "dependencies": {
    "next": "15.5.4",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "recharts": "2.15.4"
  },
  "devDependencies": {
    "@types/node": "22.15.3",
    "@types/react": "19.1.2",
    "@types/react-dom": "19.1.2",
    "autoprefixer": "10.4.21",
    "postcss": "8.5.3",
    "tailwindcss": "3.4.17",
    "tsx": "4.19.3",
    "typescript": "5.8.3"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
